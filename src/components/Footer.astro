---
import Icon from './Icon.astro';

const currentYear = new Date().getFullYear();
---

<footer>
	<div class="inner wrapper">
		<div class="group">
			<p>&copy; {currentYear} Jeanine White</p>
			<p>
				Designed & Developed in Portland with <a href="https://astro.build/">Astro</a>
				<Icon icon="rocket-launch" size="1.2em" />
			</p>
		</div>
		<p class="socials">
			<a href="https://twitter.com/me">Twitter</a>
			<a href="https://github.com/me">GitHub</a>
			<a href="https://codepen.io/me">CodePen</a>
		</p>
	</div>
</footer>

<style>
	footer {
		margin-top: var(--space-section);
		border-top: 1px solid var(--border);
		color: var(--text-subtle);
		font-size: var(--text-sm);
	}

	.inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		padding-block: var(--space-10);
		text-align: center;
	}

	footer a {
		color: var(--text-muted);
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition:
			color var(--theme-transition),
			text-decoration-color var(--theme-transition);
	}

	footer a:hover {
		color: var(--text);
		text-decoration-color: currentColor;
	}

	.group {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.socials {
		display: flex;
		justify-content: center;
		gap: var(--space-6);
		flex-wrap: wrap;
	}

	@media (min-width: 50em) {
		.inner {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			text-align: start;
		}

		.group {
			flex-direction: row;
			gap: var(--space-4);
			flex-wrap: wrap;
		}
	}
</style>
