---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, id } = Astro.props.project;
---

<a class="card card-interactive project" href={`/work/${id}`}>
	<div class="media">
		<Image
			src={data.img}
			alt={data.img_alt || ''}
			width={720}
			height={540}
			widths={[480, 720, 1080]}
			sizes="(min-width: 50em) 33rem, 100vw"
		/>
	</div>
	<span class="meta">
		<span class="title">{data.title}</span>
		<Icon icon="arrow-right" size="1.25em" />
	</span>
</a>

<style>
	.project {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		color: var(--text);
		text-decoration: none;
	}

	.media {
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: var(--surface-raised);
	}

	.media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s var(--ease);
	}

	.project:hover .media :global(img) {
		transform: scale(1.03);
	}

	.meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		padding: var(--space-4) var(--space-5);
	}

	.title {
		font-size: var(--text-lg);
		font-weight: 600;
		letter-spacing: -0.015em;
		line-height: 1.25;
	}

	.meta :global(svg) {
		flex: none;
		color: var(--text-subtle);
		transition:
			color var(--theme-transition),
			transform var(--theme-transition);
	}

	.project:hover .meta :global(svg) {
		color: var(--accent-text);
		transform: translateX(3px);
	}

	@media (prefers-reduced-motion: reduce) {
		.project:hover .media :global(img),
		.project:hover .meta :global(svg) {
			transform: none;
		}
	}

	@media (min-width: 50em) {
		.project {
			border-radius: var(--radius-xl);
		}
	}
</style>
