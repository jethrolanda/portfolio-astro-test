---
interface Props {
	title: string;
	tagline?: string;
	align?: 'start' | 'center';
}

const { align = 'center', tagline, title } = Astro.props;
---

<div class:list={['hero stack gap-4', align]}>
	<div class="stack gap-4">
		<h1 class="title">{title}</h1>
		{tagline && <p class="tagline">{tagline}</p>}
	</div>
	<slot />
</div>

<style>
	.hero {
		text-align: center;
	}

	.title,
	.tagline {
		margin-inline: auto;
	}

	.title {
		max-width: 20ch;
	}

	.tagline {
		max-width: 44ch;
		font-size: var(--text-lg);
		line-height: 1.55;
		color: var(--text-muted);
	}

	@media (min-width: 50em) {
		.tagline {
			font-size: var(--text-xl);
		}

		.start {
			text-align: start;
		}

		.start .title,
		.start .tagline {
			margin-inline: unset;
		}
	}
</style>
